[Exec]
Capability=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN CAP_SETGID CAP_SETUID
PrivateUsers=no

[Network]
VirtualEthernet=no

[Files]
Bind=/opt/zsh/.zshrc:/opt/.zshrc
Bind=/opt/oh-my-zsh:/opt/oh-my-zsh
Bind=/usr/share/zsh/plugins/zsh-syntax-highlighting/:/usr/share/zsh/plugins/zsh-syntax-highlighting/
Bind=/usr/share/zsh/plugins/zsh-autosuggestions/:/usr/share/zsh/plugins/zsh-autosuggestions/
Bind=/home/atkzero/powerlevel10k/:/root/powerlevel10k/
