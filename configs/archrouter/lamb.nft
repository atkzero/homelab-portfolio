flush ruleset

table inet filter {
    set allowed_vlans {
        typeof ip saddr
        flags interval
        elements = { 10.0.10.0/28, 10.0.1.0/29 }
      }

    chain input {
        type filter hook input priority 0; policy drop;
        iif lo accept
        ct state established,related accept
        ip protocol icmp accept
        ip6 nexthdr ipv6-icmp accept
        ip saddr @allowed_vlans tcp dport 22 accept
        udp dport { 53, 67 } accept
        tcp dport 53 accept
      }
    chain forward {
        type filter hook forward priority 0; policy drop;
        ct state established,related accept
        meta iifkind vlan oifname enp0s21f0u2u4 accept
	ip saddr 10.0.10.2 ip daddr 10.0.50.23 accept
	iifname { vlan.1, vlan.10 } meta oifkind vlan accept
	iifname vlan.1 oifname vlan.10 accept
      }
    chain output {
        type filter hook output priority 0; policy accept
      }
  }
table inet nat {
    chain postrouting {
        type nat hook postrouting priority 100; policy accept;
        oifname enp0s21f0u2u4 masquerade
      }
  }
